{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": false,
		"declarationMap": false,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@sematico/shopify-e2e/config": ["./src/config/public.cts"],
			"@sematico/shopify-e2e/playwright": ["./src/playwright/public.cts"]
		},
		"rootDir": ".",
		"types": ["node", "vitest/globals"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.cts",
		"tests/**/*.ts",
		"tests/**/*.cts",
		"vitest.config.ts"
	]
}
