{
	"name": "shopify-e2e",
	"version": "0.1.0",
	"description": "Reusable Shopify live E2E helper CLI and Playwright package.",
	"type": "module",
	"license": "MIT",
	"bin": {
		"shopify-e2e": "./bin/run.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./config": {
			"types": "./dist/config-api.d.ts",
			"import": "./dist/config-api.js"
		},
		"./inputs": {
			"types": "./dist/playwright/inputs.d.ts",
			"import": "./dist/playwright/inputs.js"
		},
		"./package.json": "./package.json",
		"./playwright": {
			"types": "./dist/playwright/index.d.ts",
			"import": "./dist/playwright/index.js"
		},
		"./storefront": {
			"types": "./dist/playwright/storefront.d.ts",
			"import": "./dist/playwright/storefront.js"
		},
		"./urls": {
			"types": "./dist/urls.d.ts",
			"import": "./dist/urls.js"
		}
	},
	"files": [
		"bin",
		"dist",
		"examples",
		"README.md"
	],
	"oclif": {
		"bin": "shopify-e2e",
		"commands": "./dist/commands",
		"topicSeparator": " ",
		"topics": {
			"auth": {
				"description": "Manage saved Shopify auth state."
			}
		}
	},
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf dist",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"prepare": "npm run build",
		"prepack": "npm run clean && npm run build",
		"test": "vitest run",
		"typecheck": "tsc --project tsconfig.test.json --noEmit"
	},
	"dependencies": {
		"@oclif/core": "4.11.11",
		"playwright-core": "^1.61.1"
	},
	"peerDependencies": {
		"@playwright/test": ">=1.61.1"
	},
	"peerDependenciesMeta": {
		"@playwright/test": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@playwright/test": "^1.61.1",
		"@types/node": "^24.10.2",
		"typescript": "^5.9.3",
		"vitest": "^4.0.15"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
